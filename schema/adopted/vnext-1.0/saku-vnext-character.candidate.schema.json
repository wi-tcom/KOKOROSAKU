    "identity":{"type":"object","additionalProperties":false,"required":["character_id","character_revision","display_name","catalog"],"x-saku-semantic-owner":"SAKU_CHARACTER","properties":{"character_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","description":"Immutable identity; catalog_code is not embedded."},"character_revision":{"$ref":"#/$defs/s"},"display_name":{"$ref":"#/$defs/s"},"catalog":{"type":"object","additionalProperties":false,"required":["catalog_version","catalog_code","catalog_group","role_label"],"x-saku-semantic-owner":"SAKU_CATALOG","properties":{"catalog_version":{"$ref":"#/$defs/s"},"catalog_code":{"type":"string","pattern":"^[CBTHRPG][0-9]{2}$"},"catalog_group":{"enum":["CORE_CROSS_FUNCTIONAL","BUSINESS","TECHNICAL","HUMAN_SERVICE","RESEARCH_CREATIVE","PROFESSIONAL_REASONING","ORGANIZATIONAL_DYNAMICS"]},"role_label":{"$ref":"#/$defs/s"}}}}},
