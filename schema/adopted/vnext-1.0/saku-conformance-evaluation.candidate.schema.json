  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:saku:candidate:conformance-evaluation:v1","title":"SAKU Character Conformance Evaluation Candidate","description":"SAKU-owned two-layer conformance result. NOT_ADOPTED.","type":"object","additionalProperties":false,
