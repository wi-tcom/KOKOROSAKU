{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saku:builder:support-bundle:candidate:1",
  "title": "SAKU Builder Support Bundle Candidate",
  "description": "Sanitized, non-authoritative diagnostics exported by SAKU Builder. This is not a Character Canonical schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "builder_version",
    "character_schema_id",
    "character_schema_version",
    "platform",
    "validation_summary",
    "validation_codes",
    "compatibility",
    "extension_declarations",
    "unsupported_features",
    "error_context",
    "provenance"
  ],
  "properties": {
    "builder_version": { "type": "string", "minLength": 1 },
    "character_schema_id": { "type": ["string", "null"] },
    "character_schema_version": { "type": ["string", "null"] },
    "platform": { "type": "string", "minLength": 1 },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "counts", "layers"],
      "properties": {
        "overall": { "enum": ["SUPPORTED", "INVALID", "UNKNOWN", "UNSUPPORTED", "NOT_CONFIGURED", "EXTERNAL_EVIDENCE_REQUIRED"] },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["INVALID", "UNKNOWN", "UNSUPPORTED", "NOT_CONFIGURED", "EXTERNAL_EVIDENCE_REQUIRED"],
          "properties": {
            "INVALID": { "type": "integer", "minimum": 0 },
            "UNKNOWN": { "type": "integer", "minimum": 0 },
            "UNSUPPORTED": { "type": "integer", "minimum": 0 },
            "NOT_CONFIGURED": { "type": "integer", "minimum": 0 },
            "EXTERNAL_EVIDENCE_REQUIRED": { "type": "integer", "minimum": 0 }
          }
        },
        "layers": {
          "type": "array",
          "items": { "enum": ["STRUCTURAL_VALIDATION", "DETERMINISTIC_CONFORMANCE", "AUTHORING_POLICY_CONFORMANCE"] },
          "uniqueItems": true
        }
      }
    },
    "validation_codes": { "type": "array", "items": { "type": "string" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_schema_id", "supported_schema_versions", "result"],
      "properties": {
        "supported_schema_id": { "type": "string" },
        "supported_schema_versions": { "type": "array", "items": { "type": "string" } },
        "result": { "enum": ["SUPPORTED", "INVALID", "UNKNOWN", "UNSUPPORTED", "NOT_CONFIGURED", "EXTERNAL_EVIDENCE_REQUIRED"] }
      }
    },
    "extension_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extension_id", "semantic_owner", "declared_capabilities", "may_enable", "integration_mode", "opaque_reference_present", "payload_digest_present", "owner_private_hint_present"],
        "properties": {
          "extension_id": { "type": ["string", "null"] },
          "semantic_owner": { "type": ["string", "null"] },
          "declared_capabilities": { "type": "array", "items": { "type": "string" } },
          "may_enable": { "type": "array", "items": { "type": "string" } },
          "integration_mode": { "type": ["string", "null"] },
          "opaque_reference_present": { "type": "boolean" },
          "payload_digest_present": { "type": "boolean" },
          "owner_private_hint_present": { "type": "boolean" }
        }
      }
    },
    "unsupported_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "reason"],
        "properties": {
          "code": { "type": "string" },
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "error_context": { "type": ["array", "object", "null"] },
    "provenance": { "type": "object" }
  }
}
